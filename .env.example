# Порт, на котором API будет доступен снаружи docker-compose
PORT=3000

# Для локального запуска без Docker (pnpm dev)
MONGO_URL=mongodb://localhost:27017/country_counter

# Sign in with Apple: bundle id iOS-приложения (aud в identity token)
APPLE_BUNDLE_ID=ge.kirillsaint.countrycounter

# Google Sign-In: client id iOS-клиента из Google Cloud Console (можно несколько через запятую).
# Пока пусто — вход через Google выключен, Apple работает.
GOOGLE_CLIENT_IDS=396212586816-2k8dfsi863mf6sjd7ak4bt3vcnkj7t5o.apps.googleusercontent.com

# Кому разрешено регистрироваться (через запятую). Пусто — кому угодно.
# Для личного сервера впишите свои email'ы.
ALLOWED_EMAILS=kirillnuwql@gmail.com


# Orizn Visa API (https://visa.orizn.app) — справочник визовых режимов для документов.
# Пусто — справочник выключен, условия въезда задаются вручную.
ORIZN_API_KEY=
