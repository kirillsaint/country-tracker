# Порт, на котором API будет доступен снаружи docker-compose
PORT=3000

# Для локального запуска без Docker (pnpm dev)
MONGO_URL=mongodb://localhost:27017/country_counter

# Sign in with Apple: bundle id iOS-приложения (aud в identity token)
APPLE_BUNDLE_ID=ge.kirillsaint.stamps

# Google Sign-In: client id iOS-клиента из Google Cloud Console (можно несколько через запятую).
# Пока пусто — вход через Google выключен, Apple работает.
GOOGLE_CLIENT_IDS=396212586816-2k8dfsi863mf6sjd7ak4bt3vcnkj7t5o.apps.googleusercontent.com

# Кому разрешено регистрироваться (через запятую). Пусто — кому угодно.
# Для личного сервера впишите свои email'ы.
ALLOWED_EMAILS=kirillnuwql@gmail.com


# Пусто — справочник выключен, условия въезда задаются вручную.

# OpenRouter — «Заполнить автоматически» для безвизовых режимов (модель с веб-поиском). Пусто — только ручной ввод.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-sol
# быстрая модель для рекомендаций и маршрутов (подбор из готового списка, отвечает за секунды)
OPENROUTER_FAST_MODEL=openai/gpt-5.6-luna

# «Чем заняться»: Google Places API (New). Пусто — раздел выключен.
GOOGLE_PLACES_API_KEY=
# публичный адрес сервера для ссылок на фото мест (в докере подставляется прод по умолчанию)
PUBLIC_BASE_URL=https://country-tracker.kirillsaint.ge

# Self Store — проверка обновлений в приложении. Адрес магазина и id приложения Stamps в нём
# (виден в адресе страницы приложения в админке: /admin/apps/<id>). Пусто — проверка выключена.
SELF_STORE_URL=https://self-store.kirillsaint.ge
SELF_STORE_APP_ID=

# Админка в браузере: https://<домен API>/admin. Вход через Google, внутрь пускаются только эти email.
# ADMIN_GOOGLE_CLIENT_ID — отдельный OAuth-клиент типа «Веб-приложение» из Google Cloud Console
# с Authorized JavaScript origins = https://<домен API> (и http://localhost:5173 для разработки).
# Пусто — админка выключена.
ADMIN_EMAILS=kirillnuwql@gmail.com
ADMIN_GOOGLE_CLIENT_ID=
# Карта точек в админке на Google Maps: браузерный ключ с включённым Maps JavaScript API, ограниченный
# по HTTP referrer (https://<домен API>/*). Пусто — карта на OpenStreetMap.
ADMIN_GOOGLE_MAPS_KEY=

