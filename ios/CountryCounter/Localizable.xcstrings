{
  "sourceLanguage": "en",
  "strings": {
    "—": {},
    "— picks lean indoors": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "— подборка ближе к помещениям"
          }
        }
      }
    },
    "· yours falls short": {
      "extractionState": "stale",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "· у вас не хватает"
